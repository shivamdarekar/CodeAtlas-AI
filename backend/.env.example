# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=BAAI/bge-small-en-v1.5

# Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=codebase-assistant

# Repository access
GITHUB_TOKEN=
REPO_TEMP_DIR=./tmp/repos

# Retrieval
TOP_K_RESULTS=8

# Chunking
CODE_CHUNK_SIZE=1500
CODE_CHUNK_OVERLAP=200
